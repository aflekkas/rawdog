# Most users should NOT copy this file. Run `rawdog` once and follow the
# interactive setup, or run `rawdog login` — keys are saved to
# ~/.config/rawdog/.env (chmod 600) and work from any cwd.
#
# This template exists for power users who want a per-project .env, or for
# CI/docker builds that inject env vars.

# Pick one (or both). RAWDOG_PROVIDER picks which to use: "openai" (default) or "anthropic"
RAWDOG_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
