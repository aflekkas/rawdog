{
  "name": "rawdog",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "rawdog": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "typecheck": "bunx tsc --noEmit",
    "build": "mkdir -p bin && bun build --compile --minify --target=bun src/index.tsx --outfile bin/rawdog"
  },
  "dependencies": {
    "@aflekkas/vibecli": "^0.0.1",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.168",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^18.3.12",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.7.2"
  }
}
